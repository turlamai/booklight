        (linux-icon . "design/app-icon.png")
        (linux-formats . ("deb" "rpm" "appimage")) (dmg-background . "design/dmg-background.png") (windows-installer-bitmaps . #hasheq((banner . "design/wizard-banner.bmp") (dialog . "design/wizard-dialog.bmp")))))
