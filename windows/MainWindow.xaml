<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational"
            Message="Starting…" />

        <!-- command bar: grouped reading actions, native Fluent button states -->
        <Border
            Grid.Row="1"
            Padding="8,4"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    x:Name="OpenButton"
                    Click="Open_Click"
                    Padding="10,6"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock x:Name="OpenLabel" Text="Open" FontSize="12" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton x:Name="LeftToggle" Click="LeftToggle_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE700;" />
                </ToggleButton>
                <Button x:Name="RecentsButton" Width="34" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE823;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="RecentsFlyout" Opening="RecentsFlyout_Opening" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="FindToggle" Click="FindToggle_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE721;" />
                </Button>
                <ToggleButton x:Name="BookmarkToggle" Click="Bookmark_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE734;" />
                </ToggleButton>
                <Button x:Name="PrintButton" Click="PrintButton_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE749;" />
                </Button>
                <Rectangle Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="ToolsButton" Width="34" Height="30" Padding="0"
                        CornerRadius="4" Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE90F;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Name="ToolsResearchItem" Click="ToolsResearch_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ToolsFillFormItem" Click="ToolsFillForm_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ToolsWatermarkItem" Click="ToolsWatermark_Click" />
                            <MenuFlyoutItem x:Name="ToolsExportPageItem" Click="ToolsExportPage_Click" />
                            <MenuFlyoutItem x:Name="ToolsSavePdfItem" Click="ToolsSavePdf_Click" />
                            <MenuFlyoutItem x:Name="ToolsExportTextItem" Click="ToolsExportText_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="AiToggle" Click="AiToggle_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE99A;" />
                </ToggleButton>
                <Button x:Name="ThemeButton" Click="Theme_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE706;" />
                </Button>
                <Button x:Name="SettingsButton" Click="Settings_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- left panel: thumbnails / outline / notes / page ops -->
            <Grid
                Grid.Column="0"
                x:Name="LeftPanel"
                Width="232"
                Padding="8,4"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" x:Name="LeftTop" />

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="2"
                    Margin="0,6,0,6"
                    x:Name="LeftModeRow">
                    <ToggleButton x:Name="ThumbsMode" Click="ThumbsMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8A9;" />
                    </ToggleButton>
                    <ToggleButton x:Name="OutlineMode" Click="OutlineMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8FD;" />
                    </ToggleButton>
                    <ToggleButton x:Name="NotesMode" Click="NotesMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE70F;" />
                    </ToggleButton>
                    <ToggleButton x:Name="FormsMode" Click="FormsMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE762;" />
                    </ToggleButton>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="LeftContent" Spacing="4" />
                </ScrollViewer>
            </Grid>

            <!-- center: tabs + welcome overlay + find bar -->
            <Grid Grid.Column="1" x:Name="CenterHost">
                <Grid x:Name="CenterHostTabs">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Pending PDF page edits (prototype pdf.html PendingEditBar):
                         edits exist only in memory — save a copy or discard. -->
                    <InfoBar
                        x:Name="PendingEditBar"
                        Grid.Row="0"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Warning"
                        Margin="12,8,12,0">
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PendingSaveButton"
                                        Click="PendingSave_Click"
                                        Padding="10,3,10,3">
                                    <TextBlock x:Name="PendingSaveText" FontSize="12" />
                                </Button>
                                <Button x:Name="PendingDiscardButton"
                                        Click="PendingDiscard_Click"
                                        Padding="10,3,10,3">
                                    <TextBlock x:Name="PendingDiscardText" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                    <TabView
                        x:Name="DocTabs"
                        Grid.Row="1"
                        SelectionChanged="DocTabs_SelectionChanged"
                        TabCloseRequested="DocTabs_CloseRequested"
                        IsAddTabButtonVisible="False" />
                </Grid>
                <!-- 研究工作台（design/prototype/research.html）：跨书检索 +
                     可溯源引用集。免费功能，无 gating（PRICING.md 2026-11-18
                     owner 决策）。三列：scope | results | citation deck. -->
                <Grid x:Name="ResearchView" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" RowSpacing="4" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="ResearchScopeTitle" Margin="16,0,12,6"
                                   FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                        <TextBlock Grid.Row="1" x:Name="ResearchOpenedTitle" Margin="16,0,12,4" FontSize="12" />
                        <StackPanel Grid.Row="2" x:Name="ResearchOpenedList" Margin="8,0,8,4" />
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="ResearchRecentsTitle" Margin="16,8,12,4"
                                           FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                                <StackPanel x:Name="ResearchRecentsList" Margin="8,0,8,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Row="4" x:Name="ResearchScopeFooter" Margin="16,8,16,14"
                                   FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Column="1" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="10" Margin="20,14,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ResearchQuery" Height="36"
                                     VerticalContentAlignment="Center" FontSize="14"
                                     KeyDown="ResearchQuery_KeyDown" />
                            <Button Grid.Column="1" x:Name="ResearchSearchButton" Height="36"
                                    Click="ResearchSearch_Click" Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                        <InfoBar Grid.Row="1" x:Name="ResearchBusyBar" IsOpen="False" IsClosable="False"
                                 IsIndeterminate="True" Severity="Informational" Margin="20,0,20,8" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ResearchResults" Margin="20,4,20,16" Spacing="8" />
                        </ScrollViewer>
                        <Grid Grid.Row="3" ColumnSpacing="14" Margin="20,7,20,7"
                              BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <TextBlock Grid.Column="0" x:Name="ResearchFooter" FontSize="11.5" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="ResearchStats" FontSize="11.5" Opacity="0.7"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="2" x:Name="ResearchDeckPane" Width="288"
                          Visibility="Collapsed" BorderThickness="1,0,0,0"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="14,12,14,8">
                            <Grid>
                                <TextBlock x:Name="ResearchDeckTitle" FontSize="13" FontWeight="Bold" />
                                <TextBlock x:Name="ResearchDeckCount" HorizontalAlignment="Right" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#B45309" />
                            </Grid>
                            <TextBlock x:Name="ResearchDeckFooter" FontSize="11" Opacity="0.55" Margin="0,4,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ResearchDeckList" Margin="12,0,12,12" Spacing="8" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
                <!-- File-first welcome: no import, library or tracking. -->
                <Grid x:Name="WelcomeView" Visibility="Visible">
                    <Border
                        MaxWidth="960"
                        Padding="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid ColumnSpacing="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" MaxWidth="360" Spacing="18">
                            <Border
                                Width="60" Height="60"
                                CornerRadius="15"
                                HorizontalAlignment="Left"
                                Background="#B45309">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="26"
                                    Glyph="&#xE82D;"
                                    Foreground="White" />
                            </Border>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Booklight"
                                           Style="{StaticResource TitleLargeTextBlockStyle}" />
                                <TextBlock x:Name="WelcomeFileHint"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="WelcomeOpenButton"
                                    Click="Open_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe Fluent Icons" />
                                    <TextBlock x:Name="WelcomeFileOpen" Text="Open Document…" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="WelcomeFileDrop"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="WelcomePrivacy"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                            <TextBlock x:Name="WelcomeRecentTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel x:Name="WelcomeRecentSection" Spacing="6">
                                <StackPanel x:Name="WelcomeRecentStack" Spacing="4" />
                            </StackPanel>
                            <TextBlock x:Name="WelcomeRecentEmpty"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
                <Border
                    x:Name="FindBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Padding="10,6"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE721;" />
                        <TextBox
                            x:Name="FindInput"
                            Width="200"
                            PlaceholderText="搜索"
                            TextChanged="FindInput_TextChanged"
                            KeyDown="FindInput_KeyDown" />
                        <TextBlock x:Name="FindCount" VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                        <Button x:Name="FindPrev" Click="FindPrev_Click" ToolTipService.ToolTip="上一个">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE74A;" />
                        </Button>
                        <Button x:Name="FindNext" Click="FindNext_Click" ToolTipService.ToolTip="下一个">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE74B;" />
                        </Button>
                        <Button x:Name="FindClose" Click="FindClose_Click" ToolTipService.ToolTip="关闭">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI sidebar -->
            <Grid
                Grid.Column="2"
                x:Name="AiPanel"
                Width="400"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Padding="8,8,8,4" x:Name="AiTabRow" />

                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="AiContent" Spacing="8" Padding="8,0,8,8" />
                </ScrollViewer>

                <Grid Grid.Row="2" x:Name="ChatInputBar" Visibility="Collapsed" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ChatInput"
                        Grid.Column="0"
                        PlaceholderText="基于文档内容提问…"
                        KeyDown="ChatInput_KeyDown" />
                    <Button x:Name="ChatSend" Grid.Column="1" Click="SendChat_Click" Margin="6,0,0,0">
                        <TextBlock x:Name="ChatSendLabel" Text="发送" />
                    </Button>
                    <Button x:Name="ChatStop" Grid.Column="2" Click="StopChat_Click" Margin="6,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ChatStopLabel" Text="停止" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- bottom bar -->
        <Grid Grid.Row="3" x:Name="BottomBar" Visibility="Collapsed" Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PageInput"
                Grid.Column="0"
                Width="48"
                Text="1"
                TextAlignment="Center"
                KeyDown="PageInput_KeyDown" />
            <TextBlock x:Name="PageTotal" Grid.Column="1" Text=" / 0" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" Opacity="0.7" />
            <TextBlock x:Name="PageInfo" Grid.Column="2" Text="" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Opacity="0.5" />
            <Button x:Name="ZoomOut" Grid.Column="4" Click="ZoomOut_Click" ToolTipService.ToolTip="缩小">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE71F;" />
            </Button>
            <Button x:Name="ZoomReset" Grid.Column="5" Click="ZoomReset_Click" ToolTipService.ToolTip="重置缩放">
                <TextBlock x:Name="ScaleLabel" Text="100%" FontSize="12" />
            </Button>
            <Button x:Name="ZoomIn" Grid.Column="6" Click="ZoomIn_Click" ToolTipService.ToolTip="放大">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8A3;" />
            </Button>
            <Button x:Name="FitWidth" Grid.Column="7" Click="FitWidth_Click" Margin="8,0,0,0">
                <TextBlock x:Name="FitWidthLabel" Text="适应宽度" FontSize="12" />
            </Button>
        </Grid>
    </Grid>
</Window>
