<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational"
            Message="Starting…" />

        <!-- command bar: grouped reading actions, native Fluent button states -->
        <Border
            Grid.Row="1"
            Padding="8,4"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    x:Name="OpenButton"
                    Click="Open_Click"
                    Padding="10,6"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock x:Name="OpenLabel" Text="Open" FontSize="12" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton x:Name="LeftToggle" Click="LeftToggle_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE700;" />
                </ToggleButton>
                <Button x:Name="RecentsButton" Width="34" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE823;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="RecentsFlyout" Opening="RecentsFlyout_Opening" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="FindToggle" Click="FindToggle_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE721;" />
                </Button>
                <ToggleButton x:Name="BookmarkToggle" Click="Bookmark_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE734;" />
                </ToggleButton>
                <ToggleButton x:Name="SplitToggle" Click="Split_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE89A;" />
                </ToggleButton>
                <ToggleButton x:Name="TtsButton" Click="TtsButton_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE720;" />
                </ToggleButton>
                <Button x:Name="PrintButton" Click="PrintButton_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE749;" />
                </Button>
                <Rectangle Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="ToolsButton" Width="34" Height="30" Padding="0"
                        CornerRadius="4" Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE90F;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem x:Name="ToolsFillFormItem" Click="ToolsFillForm_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ToolsWatermarkItem" Click="ToolsWatermark_Click" />
                            <MenuFlyoutItem x:Name="ToolsExportPageItem" Click="ToolsExportPage_Click" />
                            <MenuFlyoutItem x:Name="ToolsSavePdfItem" Click="ToolsSavePdf_Click" />
                            <MenuFlyoutItem x:Name="ToolsExportTextItem" Click="ToolsExportText_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ToggleButton x:Name="AiToggle" Click="AiToggle_Click"
                              Width="34" Height="30" Padding="0" CornerRadius="4"
                              Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE99A;" />
                </ToggleButton>
                <Button x:Name="ThemeButton" Click="Theme_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE706;" />
                </Button>
                <Button x:Name="SettingsButton" Click="Settings_Click"
                        Width="34" Height="30" Padding="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- left panel: thumbnails / outline / notes / page ops -->
            <Grid
                Grid.Column="0"
                x:Name="LeftPanel"
                Width="232"
                Padding="8,4"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" x:Name="LeftTop" />

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="2"
                    Margin="0,6,0,6"
                    x:Name="LeftModeRow">
                    <ToggleButton x:Name="ThumbsMode" Click="ThumbsMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8A9;" />
                    </ToggleButton>
                    <ToggleButton x:Name="OutlineMode" Click="OutlineMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE8FD;" />
                    </ToggleButton>
                    <ToggleButton x:Name="NotesMode" Click="NotesMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE70F;" />
                    </ToggleButton>
                    <ToggleButton x:Name="FormsMode" Click="FormsMode_Click"
                                  Width="34" Height="30" Padding="0" CornerRadius="4"
                                  Background="Transparent" BorderThickness="0">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE762;" />
                    </ToggleButton>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="LeftContent" Spacing="4" />
                </ScrollViewer>
            </Grid>

            <!-- center: tabs + welcome overlay + find bar -->
            <Grid Grid.Column="1" x:Name="CenterHost">
                <TabView
                    x:Name="DocTabs"
                    SelectionChanged="DocTabs_SelectionChanged"
                    TabCloseRequested="DocTabs_CloseRequested"
                    IsAddTabButtonVisible="False" />
                <!-- File-first welcome: no import, library or tracking. -->
                <Grid x:Name="WelcomeView" Visibility="Visible">
                    <Border
                        MaxWidth="960"
                        Padding="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid ColumnSpacing="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" MaxWidth="360" Spacing="18">
                            <Border
                                Width="60" Height="60"
                                CornerRadius="15"
                                HorizontalAlignment="Left"
                                Background="#B45309">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="26"
                                    Glyph="&#xE82D;"
                                    Foreground="White" />
                            </Border>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Booklight"
                                           Style="{StaticResource TitleLargeTextBlockStyle}" />
                                <TextBlock x:Name="WelcomeFileHint"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="WelcomeOpenButton"
                                    Click="Open_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe Fluent Icons" />
                                    <TextBlock x:Name="WelcomeFileOpen" Text="Open Document…" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="WelcomeFileDrop"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="WelcomePrivacy"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                            <TextBlock x:Name="WelcomeRecentTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel x:Name="WelcomeRecentSection" Spacing="6">
                                <StackPanel x:Name="WelcomeRecentStack" Spacing="4" />
                            </StackPanel>
                            <TextBlock x:Name="WelcomeRecentEmpty"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.6"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
                <Border
                    x:Name="FindBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Padding="10,6"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE721;" />
                        <TextBox
                            x:Name="FindInput"
                            Width="200"
                            PlaceholderText="搜索"
                            TextChanged="FindInput_TextChanged"
                            KeyDown="FindInput_KeyDown" />
                        <TextBlock x:Name="FindCount" VerticalAlignment="Center" FontSize="11" Opacity="0.7" />
                        <Button x:Name="FindPrev" Click="FindPrev_Click" ToolTipService.ToolTip="上一个">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE74A;" />
                        </Button>
                        <Button x:Name="FindNext" Click="FindNext_Click" ToolTipService.ToolTip="下一个">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE74B;" />
                        </Button>
                        <Button x:Name="FindClose" Click="FindClose_Click" ToolTipService.ToolTip="关闭">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI sidebar -->
            <Grid
                Grid.Column="2"
                x:Name="AiPanel"
                Width="400"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Padding="8,8,8,4" x:Name="AiTabRow" />

                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="AiContent" Spacing="8" Padding="8,0,8,8" />
                </ScrollViewer>

                <Grid Grid.Row="2" x:Name="ChatInputBar" Visibility="Collapsed" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ChatInput"
                        Grid.Column="0"
                        PlaceholderText="基于文档内容提问…"
                        KeyDown="ChatInput_KeyDown" />
                    <Button x:Name="ChatSend" Grid.Column="1" Click="SendChat_Click" Margin="6,0,0,0">
                        <TextBlock x:Name="ChatSendLabel" Text="发送" />
                    </Button>
                    <Button x:Name="ChatStop" Grid.Column="2" Click="StopChat_Click" Margin="6,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ChatStopLabel" Text="停止" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- bottom bar -->
        <Grid Grid.Row="3" x:Name="BottomBar" Visibility="Collapsed" Padding="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="PageInput"
                Grid.Column="0"
                Width="48"
                Text="1"
                TextAlignment="Center"
                KeyDown="PageInput_KeyDown" />
            <TextBlock x:Name="PageTotal" Grid.Column="1" Text=" / 0" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" Opacity="0.7" />
            <TextBlock x:Name="PageInfo" Grid.Column="2" Text="" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Opacity="0.5" />
            <Button x:Name="ZoomOut" Grid.Column="4" Click="ZoomOut_Click" ToolTipService.ToolTip="缩小">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE71F;" />
            </Button>
            <Button x:Name="ZoomReset" Grid.Column="5" Click="ZoomReset_Click" ToolTipService.ToolTip="重置缩放">
                <TextBlock x:Name="ScaleLabel" Text="100%" FontSize="12" />
            </Button>
            <Button x:Name="ZoomIn" Grid.Column="6" Click="ZoomIn_Click" ToolTipService.ToolTip="放大">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE8A3;" />
            </Button>
            <Button x:Name="FitWidth" Grid.Column="7" Click="FitWidth_Click" Margin="8,0,0,0">
                <TextBlock x:Name="FitWidthLabel" Text="适应宽度" FontSize="12" />
            </Button>
        </Grid>
    </Grid>
</Window>
